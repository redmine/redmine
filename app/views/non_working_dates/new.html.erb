<%= title [l(:label_non_working_date_plural), non_working_dates_path], l(:label_non_working_date_new) %>

<%= labelled_form_for @non_working_date do |f| %>
  <%= render :partial => 'form', :locals => {:f => f} %>
  <%= submit_tag l(:button_create) %>
  <%= submit_tag l(:button_create_and_continue), :name => 'continue' %>
<% end %>
